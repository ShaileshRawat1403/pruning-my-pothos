# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# stray/backup build caches (created by tooling; never commit or watch these)
.next-*
/.turbo/
# websiteops conform bridge — local staging area for draft packets
/.websiteops/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build / artifacts
/dist/
/site.zip
/.content-collections/
/.astro/

# leftover cover-art preview/sample files (not linked from any page)
/public/covers/_samples/
/public/covers/_samples2/

# Local-only design material (never published)
/private/
/src/app/dank-samples/

# Owner working docs (never commit)
/docs/ARCHIVE_DISPOSITION_LEDGER.md
/docs/CAROUSEL_VISUAL_SYSTEM_V1.md
/docs/POST_BENCHMARK_PRODUCT_INSIGHTS.md
